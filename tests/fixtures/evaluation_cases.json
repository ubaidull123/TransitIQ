    {
      "input": {
        "shipment_id": "EVAL-001",
        "source": "email",
        "reported_at": "2026-09-01T08:15:00Z",
        "carrier": "Maersk",
        "origin": "Shanghai, CN",
        "destination": "Hamburg, DE",
        "raw_text": "Customs has placed the shipment on hold because the commercial invoice is missing the pharmaceutical product license. The container contains temperature-sensitive insulin and has been waiting for 18 hours.",
        "metadata": {
          "commodity": "pharmaceuticals",
          "temperature_controlled": true,
          "container_id": "MSCU1234567"
        }
      },
      "expected": {
        "exception_type": "customs_hold",
        "severity": "critical",
        "missing_information": ["product license", "current container temperature", "customs deadline"],
        "action_themes": ["contact customs broker", "obtain missing license", "monitor temperature"]
      }
    },
